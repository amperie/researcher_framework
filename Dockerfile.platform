FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/opt/service-venv \
    PATH="/opt/service-venv/bin:$PATH" \
    RESEARCHER_HOST=0.0.0.0

RUN pip install --no-cache-dir uv==0.10.6
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --only-group platform --no-install-project
COPY core ./core
COPY database ./database
COPY configs/config.py configs/config.yaml ./configs/
COPY configs/platform_profiles ./configs/platform_profiles
RUN useradd --create-home researcher
USER researcher
EXPOSE 8091
CMD ["python", "-m", "core.platform"]
